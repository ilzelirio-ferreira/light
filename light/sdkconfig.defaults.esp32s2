# ESP32-S2: Wi-Fi Matter test, no Bluetooth.
CONFIG_BT_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n

# Keep the native USB connection available as the serial console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_CDC=y

# ROM text routines use Newlib reentrancy structures on ESP32-S2.
CONFIG_LIBC_PICOLIBC=n
CONFIG_LIBC_NEWLIB=y

# Six independent wall switches and active-low relay outputs.
CONFIG_RELAY_ACTIVE_LOW=y

CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=7

# Web configuration AP and per-channel Matter labels.
CONFIG_ENABLE_WIFI_AP=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_SUPPORT_FIXED_LABEL_CLUSTER=y
CONFIG_CUSTOM_DEVICE_INFO_PROVIDER=y
# Updates are handled by the authenticated web OTA endpoint.
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ENABLE_ESP32_DEVICE_INFO_PROVIDER=y
CONFIG_LWIP_MAX_SOCKETS=16
